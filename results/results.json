  "scenarios": [
    {
      "id": "S01",
      "title": "Read one content record by ID",
      "category": "read",
      "intent": "The single most common CMS request: a client fetches one record by its primary key and gets JSON back. Exercises routing, auth check, one indexed point lookup, and JSON marshaling.",
      "rate": "500/s",
      "threshold": "p95 < 50 ms"
    },
    {
      "id": "S02",
      "title": "List 50 records (page 1)",
      "category": "read",
      "intent": "The list view behind every admin table and public index page. Exercises a bounded, ordered scan plus serializing 50 rows.",
      "rate": "300/s",
      "threshold": "p95 < 80 ms"
    },
    {
      "id": "S03",
      "title": "Create one record",
      "category": "write",
      "intent": "The write path: validate a body, insert one row, fire lifecycle hooks, return the created record. The scenario that stresses the DB write side and any hook/event machinery.",
      "rate": "100/s",
      "threshold": "p95 < 120 ms"
    },
    {
      "id": "S04",
      "title": "Filter by an indexed field",
      "category": "read",
      "intent": "A query with a WHERE clause on an indexed column plus pagination, the shape most real API reads take. Catches missing indexes and N+1 relation loading.",
      "rate": "200/s",
      "threshold": "p95 < 90 ms"
    },
    {
      "id": "S05",
      "title": "Authenticate (token issuance)",
      "category": "auth",
      "intent": "Login deliberately runs a slow password hash (bcrypt or argon2), and this scenario measures how gracefully each platform absorbs a burst of logins without the hash starving everything else.",
      "rate": "20/s",
      "threshold": "p95 < 1000 ms"
    }
  ],
